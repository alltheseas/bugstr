{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugstr.dev/schemas/fingerprint-vectors.schema.json",
  "title": "BugStr Fingerprint Test Vectors",
  "description": "Schema for fingerprint algorithm test vectors. Used to validate that all SDK implementations produce identical fingerprints for the same input.",
  "type": "object",
  "required": ["version", "algorithm", "vectors", "assertions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Schema version (semver)."
    },
    "algorithm": {
      "type": "string",
      "description": "Fingerprint algorithm version prefix (e.g., 'v1')."
    },
    "description": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "input", "expected_fingerprint"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Unique identifier for this vector (snake_case)."
          },
          "notes": {
            "type": "string",
            "description": "Human-readable explanation of what this vector tests."
          },
          "input": {
            "type": "object",
            "required": ["exception_type", "message", "stack_trace"],
            "properties": {
              "exception_type": {
                "type": ["string", "null"],
                "description": "Exception class name (e.g., 'StateError')."
              },
              "message": {
                "type": ["string", "null"],
                "description": "Human-readable error message."
              },
              "stack_trace": {
                "type": ["string", "null"],
                "description": "Full stack trace as a multi-line string."
              }
            },
            "additionalProperties": false
          },
          "expected_fingerprint": {
            "type": "string",
            "pattern": "^v[0-9]+:[0-9a-f]{32}$",
            "description": "Expected fingerprint output (e.g., 'v1:51a4d2d9e864c799bb699e82ca34667c')."
          },
          "expected_title": {
            "type": "string",
            "description": "Expected human-readable group title."
          }
        },
        "additionalProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "vectors", "relation"],
        "properties": {
          "rule": {
            "type": "string",
            "description": "Unique identifier for this assertion (snake_case)."
          },
          "description": {
            "type": "string"
          },
          "vectors": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2,
            "description": "Pair of vector descriptions to compare."
          },
          "relation": {
            "type": "string",
            "enum": ["equal", "not_equal"],
            "description": "Expected relationship between the two vectors' fingerprints."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
